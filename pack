#!/usr/bin/env bash
# Build a zip suitable for https://extensions.gnome.org/upload/
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"

rm -f schemas/gschemas.compiled
rm -f ./*.shell-extension.zip ./*.zip

gnome-extensions pack -f \
	--extra-source=icon.png \
	--extra-source=icon-22.png \
	--extra-source=icons

zip_name="$(ls -1 ./*.shell-extension.zip | head -n1)"
mv -- "$zip_name" AI-Usage-Extension.zip
zip_name=AI-Usage-Extension.zip
echo "Created: $repo_dir/$zip_name"
echo "Upload that file at https://extensions.gnome.org/upload/"
unzip -l "$zip_name"
