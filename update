#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
uuid="cursor-usage@byte4day.github.io"
target_dir="$HOME/.local/share/gnome-shell/extensions/$uuid"

if [ "$repo_dir" = "$target_dir" ]; then
	echo "Refusing to deploy from the installed extension directory"
	exit 1
fi

rm -rf "$target_dir"
mkdir -p "$(dirname "$target_dir")"
mkdir -p "$target_dir/schemas"
cp -a "$repo_dir/extension.js" "$repo_dir/prefs.js" \
  "$repo_dir/stylesheet.css" "$repo_dir/metadata.json" \
  "$repo_dir/icon.png" "$repo_dir/icon-22.png" "$target_dir/"
cp -a "$repo_dir/icons" "$target_dir/"
cp -a "$repo_dir/schemas/org.gnome.shell.extensions.cursor-usage.gschema.xml" \
  "$target_dir/schemas/"
glib-compile-schemas "$target_dir/schemas"

echo "Installed to $target_dir"
echo "Enable with: gnome-extensions enable $uuid"
echo "Wayland: log out and back in. X11: Alt+F2, type r, Enter."
