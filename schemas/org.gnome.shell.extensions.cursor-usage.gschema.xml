<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.cursor-usage" path="/org/gnome/shell/extensions/cursor-usage/">
    <key name="refresh-interval" type="i">
      <default>300</default>
      <summary>Refresh interval</summary>
      <description>How often to refresh usage data in seconds</description>
    </key>
    <key name="display-mode" type="s">
      <default>'ring'</default>
      <summary>Display mode</summary>
      <description>Panel display: ring or text</description>
    </key>
    <key name="panel-provider" type="s">
      <default>'max'</default>
      <summary>Panel provider</summary>
      <description>Which provider drives the panel: max, cursor, claude, or codex</description>
    </key>
    <key name="panel-window" type="s">
      <default>'max'</default>
      <summary>Panel usage pool</summary>
      <description>Which pool within a provider: max, auto, api, or total</description>
    </key>
    <key name="usage-display" type="s">
      <default>'used'</default>
      <summary>Usage value display</summary>
      <description>Show used or remaining percentages</description>
    </key>
    <key name="show-icon" type="b">
      <default>true</default>
      <summary>Show icon</summary>
      <description>Show the panel icon in the top bar</description>
    </key>
    <key name="show-billing" type="b">
      <default>false</default>
      <summary>Show billing line</summary>
      <description>Show Cursor billing / Claude extra / Codex credits when available</description>
    </key>
    <key name="show-tier" type="b">
      <default>true</default>
      <summary>Show tier</summary>
      <description>Show the plan tier in the top bar</description>
    </key>
    <key name="show-cursor" type="b">
      <default>true</default>
      <summary>Show Cursor</summary>
      <description>Fetch and show Cursor usage</description>
    </key>
    <key name="show-claude" type="b">
      <default>true</default>
      <summary>Show Claude</summary>
      <description>Fetch and show Claude Code usage</description>
    </key>
    <key name="show-codex" type="b">
      <default>true</default>
      <summary>Show Codex</summary>
      <description>Fetch and show OpenAI Codex usage</description>
    </key>
    <key name="proxy-url" type="s">
      <default>''</default>
      <summary>Proxy URL</summary>
      <description>Optional HTTP proxy URL</description>
    </key>
  </schema>
</schemalist>
